LLM_BASE_URL=your_llm_base_url
LLM_API_KEY=your_llm_api_key
LLM_MODEL_ID=your_llm_model_id
LLM_EMBEDDING_MODEL=your-embedding-model

LLM_TIMEOUT=60

# ===== LLM 失败治理 =====
# 单次调用的最大尝试次数（含首次，3 = 最多重试2次，仅对可重试错误生效）
LLM_MAX_RETRIES=3
# 指数退避基数（秒），等待时间在 [0, base*2^attempt] 内随机
LLM_RETRY_BASE_DELAY=1.0
# 单次等待上限（秒）
LLM_RETRY_MAX_DELAY=30.0
# SQL 生成/修复启用 JSON 结构化输出（服务端不支持时自动降级）
LLM_JSON_MODE=true

# ===== 可观测性 =====
OBS_LOG_LEVEL=INFO
# trace 落盘开关（data/traces/*.jsonl）
OBS_TRACE_ENABLED=true
OBS_TRACE_DIR=data/traces
# /metrics 端点开关
METRICS_ENABLED=true

# 可选：本地rerank模型（sentence-transformers CrossEncoder），不配置则用默认 BAAI/bge-reranker-base
# RERANK_MODEL_ID=BAAI/bge-reranker-base
